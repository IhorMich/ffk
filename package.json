{
  "name": "ffk",
  "private": true,
  "description": "Matchcard — GitHub Pages PWA and Capacitor Android/iOS shells",
  "scripts": {
    "www": "node scripts/sync-www.js",
    "cap:sync": "npm run www && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "android:release": "bash scripts/android-release.sh",
    "ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
